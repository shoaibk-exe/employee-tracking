# Copy to .env and fill in. Never commit real credentials.

# Optional overrides
MTMCT_SETTINGS=config/settings.yaml
MTMCT_DATABASE_URL=sqlite:///data/store/mtmct.db

# RTSP credentials (referenced from cameras.yaml via ${VAR})
CAM1_USER=
CAM1_PASS=
CAM2_USER=
CAM2_PASS=
CAM3_USER=
CAM3_PASS=
CAM4_USER=
CAM4_PASS=

# API
MTMCT_API_HOST=0.0.0.0
MTMCT_API_PORT=8090
