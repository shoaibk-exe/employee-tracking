# rtsp = live CCTV URLs below
# mp4  = recorded files / pasted video paths below
SOURCE_MODE=rtsp

# --- used when SOURCE_MODE=rtsp ---
FACE_RTSP_URL=rtsp://user:password@10.0.0.21:554/stream1
OCCUPANCY_RTSP_URL=rtsp://user:password@10.0.0.22:554/stream1
# extra occupancy cameras (comma-separated), for later
OCCUPANCY_RTSP_URLS=

# --- used when SOURCE_MODE=mp4 ---
FACE_MP4_PATH=D:/videos/face_cam.mp4
OCCUPANCY_MP4_PATH=D:/videos/office_cam.mp4
OCCUPANCY_MP4_PATHS=
MP4_LOOP=true

# InsightFace
INSIGHTFACE_MODEL=buffalo_l
FACE_SIMILARITY_THRESHOLD=0.40
FACE_DET_SIZE=640

# YOLO — drop your custom chair weights here; yolov8n.pt is used if missing
YOLO_MODEL_PATH=models/chair.pt
YOLO_CHAIR_CLASS=chair
YOLO_PERSON_CLASS=person
# only used if the chair model has no person class
PERSON_MODEL_PATH=

YOLO_CONF=0.35
PERSON_CHAIR_IOU=0.05
AWAY_CONFIRM_SECONDS=8

# Capture
CAPTURE_RECONNECT_SECONDS=3
MAX_BAD_FRAMES=30
OPEN_TIMEOUT_SECONDS=8
FRAME_MAX_WIDTH=1280
