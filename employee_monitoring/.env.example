# Copy to .env. Do not commit the filled-in file.

DATABASE_URL=postgresql+psycopg://monitor:monitor@localhost:5432/employee_monitoring
# Local file database, if Postgres is not running yet:
# DATABASE_URL=sqlite:///./data/monitor.db

API_KEY=change-me
ALLOW_INSECURE_API=false
LOCAL_TIMEZONE=UTC
RUN_PIPELINE=true
LOG_LEVEL=INFO
RETAIN_FACE_IMAGES=false

ENTRANCE_CAMERA_RTSP=rtsp://user:password@10.0.0.21:554/stream1
OFFICE_CAMERA_RTSP=rtsp://user:password@10.0.0.22:554/stream1
